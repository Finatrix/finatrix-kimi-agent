<?xml version="1.0" encoding="utf-8"?>
<!-- Small widget. Ids are shared with the medium layout so one render() fills both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fx_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fx_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fx_widget_label"
        android:textColor="@color/fx_widget_ink2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/fx_widget_amount"
        android:text="@string/fx_widget_preview_amount"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="30sp"
        android:textColor="@color/fx_widget_ink"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fx_widget_prompt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="@color/fx_widget_ink"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fx_widget_add"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/fx_widget_add_bg"
        android:contentDescription="@string/fx_widget_add_a11y"
        android:gravity="center"
        android:text="@string/fx_widget_add"
        android:textColor="#0A0A0A"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
