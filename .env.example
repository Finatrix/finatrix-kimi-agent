# FinatriX backend (Supabase) — copy this file to ".env" and fill in your values.
# Find both values in your Supabase project: Settings → API.
#
# These are PUBLIC client keys (safe to ship in a browser app). Never put the
# Supabase "service_role" key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Privacy-first analytics ingest endpoint (the deployed `analytics-collect`
# Supabase edge function URL). If unset at RUNTIME all analytics/observability
# is fully disabled — no events, no beacons. Analytics is also disabled for any
# visitor with Do-Not-Track or Global Privacy Control enabled.
#
# REQUIRED for a deployable build, despite that: `vite.config.ts` refuses to
# build without it (REQUIRED_FOR_DEPLOYABLE_BUILD), because these values are
# inlined at build time and a bundle missing this one ships with observability
# silently off for every visitor — which is exactly how it went unnoticed
# before. Building without a backend on purpose? Use the documented escape
# hatch: FX_ALLOW_UNCONFIGURED_BUILD=1 npm run build
#
# e.g. https://YOUR-PROJECT-ref.supabase.co/functions/v1/analytics-collect
VITE_ANALYTICS_URL=

# The production origin advertised in <link rel="canonical"> and og:url.
# OPTIONAL and normally left blank — it defaults to https://finatrix.co, the
# canonical apex (CANONICAL_HOST in src/shared/routes.ts), so an un-configured
# build is still correct. Only override it to point a fork at its own domain,
# and never at a preview, *.workers.dev or localhost host: doing so publishes
# canonical tags for a URL Google cannot serve, which de-indexes the real site.
VITE_CANONICAL_ORIGIN=


# ═══════════════════════════════════════════════════════════════════════════
#  SERVER-SIDE SECRETS — these do NOT belong in this file or in any VITE_ var.
#  Set them with `supabase secrets set NAME=value`. Listed here because the
#  NAMES are contractual: the edge functions read these exact strings and
#  nothing else. A key stored under a marketplace label ("Active Jobs DB",
#  "Google Jobs") is invisible to the code — the provider silently returns
#  nothing forever. `careers-jobs` logs a startup warning when it detects this.
# ═══════════════════════════════════════════════════════════════════════════
#
# Job providers — every one optional; a provider without its key reports
# "not-configured" and is never called.
#   RAPIDAPI_KEY            shared fallback for all six RapidAPI providers below
#   ACTIVE_JOBS_KEY         Active Jobs DB          (falls back to RAPIDAPI_KEY)
#   LINKEDIN_JOBS_KEY       LinkedIn Job Search     (falls back to RAPIDAPI_KEY)
#   JOB_POSTING_FEED_KEY    Job Posting Feed        (falls back to RAPIDAPI_KEY)
#   GOOGLE_JOBS_KEY         Google Jobs             (falls back to RAPIDAPI_KEY)
#   GLASSDOOR_KEY           Glassdoor Real-Time     (falls back to RAPIDAPI_KEY)
#   WORKDAY_KEY             Workday aggregator      (falls back to RAPIDAPI_KEY)
#   WORKDAY_HOST            REQUIRED for Workday — it has no global endpoint, so
#                           without a host the provider can never run
#   ADZUNA_APP_ID / ADZUNA_APP_KEY, JOOBLE_KEY   incumbent providers
#
# AI
#   OPENROUTER_API_KEY      required by careers-ai
#   CAREERS_AI_MODELS       optional, comma-separated model allowlist
#   CAREERS_AI_DAILY_LIMIT  optional, default 60 calls/user/day
#   CAREERS_AI_RATE_PER_MINUTE           optional, default 20
#
# careers-jobs tuning
#   CAREERS_JOBS_RATE_PER_MINUTE         optional, default 30  (per authenticated user)
#   CAREERS_JOBS_UNAUTH_RATE_PER_MINUTE  optional, default 60  (per IP, pre-auth)
#   CAREERS_PROVIDER_RETRIES             optional, default 1, clamped 0–2
#   CAREERS_DISABLED_PROVIDERS           optional, comma-separated kill-switch
#   CAREERS_ALLOWED_ORIGINS              optional, comma-separated CORS allowlist
#
# Injected by the Supabase platform — do not set by hand:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
