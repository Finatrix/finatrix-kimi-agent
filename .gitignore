# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-verify
*.local

# Local environment variables (Supabase keys)
.env

# Apple private keys (Sign in with Apple, App Store Connect API). Apple lets a
# .p8 be downloaded exactly once, so it tends to get copied next to the code
# that uses it — and one commit puts it in the history for good. They belong in
# a password manager and in edge-function secrets (scripts/configure-apple-signin.mjs).
*.p8

# Signed iOS archives and exported .ipa files (scripts/ios-release.sh).
ios/release-candidates/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# stray duplicate created during setup (safe to delete)
/finatrix-kimi-agent

# Python bytecode from the dev-only scripts in scripts/ (favicons, OG cards)
__pycache__/

# Supabase CLI local state
supabase/.temp/
.fuse_hidden*

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Wrangler local dev state (created by `wrangler dev`).
.wrangler/
